---
import Layout from '../../layouts/Layout.astro';
import { TYPES, TEMPLATES, BEADS, FILLER } from '../../data/konstruktor-v2.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const img = `${base}images/konstruktor/`;
const master = 'https://t.me/vafanasievav';
const rub = (n) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' ₽';
const t0 = TYPES[0], z0 = t0.sizes[0];
const data = JSON.stringify({ TYPES, TEMPLATES, BEADS, FILLER });
---
<Layout title="Конструктор браслетов — ViVA" description="Соберите браслет ViVA из натуральных камней: перетаскивайте бусины на браслет и сразу видите результат и цену." noindex>
  <section class="v2">
    <div class="container v2-wrap">
      <div class="v2-head">
        <div class="breadcrumbs">Главная / Конструктор / Новая версия</div>
        <h1>Соберите браслет</h1>
        <p>Перетащите камень из ленты на браслет — он встанет на ближайшее место. Бусины на браслете можно менять местами, а унесённая с браслета бусина снова станет белой.</p>
      </div>

      <div class="v2-pick">
        <div class="v2-field">
          <small>тип браслета</small>
          <div class="v2-pills" id="v2Types" role="radiogroup" aria-label="Тип браслета">
            {TYPES.map((t) => (
              <button type="button" class="v2-pill" data-type={t.id} aria-pressed={String(t.id === t0.id)}>{t.name}</button>
            ))}
          </div>
        </div>
        <div class="v2-field">
          <small id="v2SizeLabel">{t0.sizeLabel}</small>
          <div class="v2-pills" id="v2Sizes" role="radiogroup" aria-label="Размер">
            {t0.sizes.map((z) => <button type="button" class="v2-pill" data-size={z.id} aria-pressed="true">{z.name}</button>)}
          </div>
        </div>
      </div>

      <div class="v2-stage-wrap">
        <div class="v2-stage" id="v2Stage">
          <svg class="v2-cord" id="v2Cord" viewBox="0 0 1000 620" aria-hidden="true"></svg>
          <div class="v2-beads" id="v2Beads" role="group" aria-label="Бусины браслета"></div>
          <p class="v2-empty" id="v2Empty">Перетащите камень из ленты на браслет</p>
          <div class="v2-badge" aria-live="polite"><small>Итого</small><b id="v2StageTotal">{rub(z0.price)}</b></div>
        </div>
      </div>

      <div class="v2-tools">
        <button type="button" class="v2-auto" id="v2Auto">
          <span class="v2-auto-ico" aria-hidden="true">⚡</span>
          <span><b>Собрать автоматически</b><small>из ваших бусин, до конца</small></span>
        </button>
        <div class="v2-mini-tools">
          <button type="button" class="v2-link" id="v2Undo" disabled>Отменить</button>
          <button type="button" class="v2-link" id="v2Clear">Очистить</button>
          <span class="v2-tpl">Шаблон:
            {TEMPLATES.map((t) => <button type="button" class="v2-link" data-tpl={t.id}>{t.name}</button>)}
          </span>
        </div>
        <p class="v2-msg" id="v2Msg" role="status" aria-live="polite"></p>
      </div>

      <div class="v2-palette">
        <div class="v2-tabs" role="tablist">
          <button type="button" class="v2-tab" data-tab="all" aria-pressed="true">Все бусины <span>{BEADS.length}</span></button>
          <button type="button" class="v2-tab" data-tab="used" aria-pressed="false">В браслете</button>
          <button type="button" class="v2-tab" data-tab="fav" aria-pressed="false">♡ Избранное</button>
          <label class="v2-search"><span class="visually-hidden">Поиск камня</span><input type="search" id="v2Search" placeholder="Найти камень" autocomplete="off" /></label>
        </div>
        <div class="v2-track" id="v2Track">
          {BEADS.map((s) => (
            <div class="v2-item" data-id={s.id} data-name={s.name.toLowerCase()}>
              <button type="button" class="v2-take" aria-label={`Добавить ${s.name} в браслет`}>
                <img src={`${img}bead-${s.id === FILLER ? 'white' : s.id}.png`} alt="" width="64" height="64" draggable="false" />
              </button>
              <span class="v2-iname">{s.name}</span>
              <span class="v2-iprice">{s.price ? '+' + rub(s.price) : 'в цене'}</span>
              <button type="button" class="v2-fav" aria-pressed="false" aria-label={`В избранное: ${s.name}`}>♡</button>
            </div>
          ))}
        </div>
        <p class="v2-hint">На компьютере перетаскивайте камни мышью. На телефоне потяните камень вверх, к браслету. Можно и без перетаскивания: нажмите бусину на браслете (или несколько), затем камень в ленте.</p>
      </div>

      <div class="v2-summary" id="v2Summary">
        <div class="eyebrow">Ваш браслет</div>
        <p class="v2-sum-title" id="v2Title">{t0.name}</p>
        <dl class="v2-lines" id="v2Lines"></dl>
        <div class="v2-total"><span>Итого</span><b id="v2Total">{rub(z0.price)}</b></div>
        <div class="v2-actions">
          <a class="button" id="v2Order" href={master} target="_blank" rel="noopener">Обсудить с мастером</a>
          <button class="button outline" type="button" id="v2Copy">Скопировать ссылку</button>
        </div>
        <p class="v2-status" id="v2Status" role="status" aria-live="polite"></p>
        <p class="v2-fine">Это новая версия конструктора, она в разработке. Цены и названия ориентировочные, окончательную стоимость подтверждает мастер. По кнопке «Обсудить с мастером» откроется Telegram, а описание браслета скопируется.</p>
      </div>
    </div>
  </section>

  <script type="application/json" id="v2Data" set:html={data}></script>
  <script is:inline>
    (function () {
      var D = JSON.parse(document.getElementById('v2Data').textContent);
      var $ = function (id) { return document.getElementById(id); };
      var stage = $('v2Stage'), beadsBox = $('v2Beads'), cord = $('v2Cord'), track = $('v2Track');
      var imgDir = document.querySelector('.v2-take img').getAttribute('src').replace(/bead-[a-z-]+\.png$/, '');
      var rub = function (n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' ₽'; };
      var byId = function (list, id) { for (var i = 0; i < list.length; i++) if (list[i].id === id) return list[i]; return list[0]; };
      var bead = function (id) { return byId(D.BEADS, id); };
      var FILL = D.FILLER;
      // белая бусина-заготовка нарисована отдельно, матовой; остальные — картинки камней
      var sprite = function (id) { return imgDir + 'bead-' + (id === FILL ? 'white' : id) + '.png'; };
      // холст 1000×620: браслет — наклонённый овал, задняя часть дальше от зрителя
      var CX = 500, CY = 300, RX = 340, RY = 165;

      var type = D.TYPES[0], size = type.sizes[0];
      var slots = [], sel = [], undo = [], tab = 'all', favs = [], orderText = '';

      function store(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
      function load(k) { try { return JSON.parse(localStorage.getItem(k)); } catch (e) { return null; } }
      favs = load('viva-kb2-favs') || [];

      function fit(n) { while (slots.length < n) slots.push(FILL); slots.length = n; sel = sel.filter(function (i) { return i < n; }); }
      function snapshot() { return { t: type.id, z: size.id, s: slots.slice() }; }
      function remember() { undo.push(snapshot()); if (undo.length > 60) undo.shift(); $('v2Undo').disabled = false; }
      function restore(st) {
        type = byId(D.TYPES, st.t); size = byId(type.sizes, st.z);
        slots = (st.s || []).map(function (id) { return bead(id).id; }); fit(size.count);
      }

      // позиции бусин: угол по овалу, глубина 0 (сзади) … 1 (спереди)
      function layout() {
        var n = slots.length, gap = type.gap, pts = [];
        var span = 360 - gap, step = gap ? span / (n - 1) : 360 / n, start = gap ? -90 + gap / 2 : 90;
        var dRad = step * Math.PI / 180, D0 = Math.min(138, RX * dRad * 1.02);
        for (var i = 0; i < n; i++) {
          var a = (start + i * step) * Math.PI / 180;
          var depth = (Math.sin(a) + 1) / 2, sc = 0.7 + 0.3 * depth;
          pts.push({ x: CX + RX * Math.cos(a), y: CY + RY * Math.sin(a), d: D0 * sc, depth: depth });
        }
        return pts;
      }

      function drawCord(pts) {
        var s = '<defs><radialGradient id="v2Shade" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#403d2f" stop-opacity=".22"/><stop offset="1" stop-color="#403d2f" stop-opacity="0"/></radialGradient></defs>';
        s += '<ellipse cx="' + CX + '" cy="' + (CY + RY + 70) + '" rx="' + (RX + 40) + '" ry="46" fill="url(#v2Shade)"/>';
        if (type.gap) {
          // плетёный замок: дуга сзади с узелками и шнур к крайним бусинам
          var g = type.gap / 2 + 4, a0 = (-90 - g) * Math.PI / 180, a1 = (-90 + g) * Math.PI / 180;
          var p0 = [CX + RX * Math.cos(a0), CY + RY * Math.sin(a0)], p1 = [CX + RX * Math.cos(a1), CY + RY * Math.sin(a1)];
          var arc = 'M' + p0[0] + ' ' + p0[1] + ' A' + RX + ' ' + RY + ' 0 0 1 ' + p1[0] + ' ' + p1[1];
          s += '<path d="' + arc + '" fill="none" stroke="#24221d" stroke-width="28" stroke-linecap="round"/>';
          // узелки плетения: наклонные петли попеременно влево и вправо
          var knots = 22;
          for (var k = 0; k <= knots; k++) {
            var a = a0 + (a1 - a0) * k / knots, x = CX + RX * Math.cos(a), y = CY + RY * Math.sin(a);
            var tan = Math.atan2(RY * Math.cos(a), -RX * Math.sin(a)) * 180 / Math.PI;
            [-1, 1].forEach(function (side) {
              s += '<ellipse cx="' + x.toFixed(1) + '" cy="' + (y + side * 6).toFixed(1) + '" rx="9" ry="5.5" fill="#3b3830" stroke="#14130f" stroke-width="1.2" transform="rotate(' + (tan + side * 32).toFixed(1) + ' ' + x.toFixed(1) + ' ' + (y + side * 6).toFixed(1) + ')"/>';
            });
          }
        } else {
          s += '<ellipse cx="' + CX + '" cy="' + CY + '" rx="' + RX + '" ry="' + RY + '" fill="none" stroke="#c9c4b4" stroke-width="3"/>';
        }
        cord.innerHTML = s;
      }

      function render() {
        var pts = layout();
        drawCord(pts);
        beadsBox.innerHTML = '';
        pts.map(function (p, i) { return [p, i]; }).sort(function (a, b) { return a[0].depth - b[0].depth; }).forEach(function (pi) {
          var p = pi[0], i = pi[1], s = bead(slots[i]);
          var el = document.createElement('img');
          el.className = 'v2-bead' + (sel.indexOf(i) >= 0 ? ' is-sel' : '');
          el.src = sprite(s.id); el.alt = ''; el.draggable = false;
          el.setAttribute('data-i', i); el.setAttribute('role', 'button'); el.tabIndex = 0;
          el.setAttribute('aria-label', 'Бусина ' + (i + 1) + ': ' + s.name + (sel.indexOf(i) >= 0 ? ', выделена' : ''));
          el.style.left = (p.x - p.d / 2) / 10 + '%'; el.style.top = (p.y - p.d / 2) / 6.2 + '%';
          el.style.width = p.d / 10 + '%'; el.style.zIndex = Math.round(p.depth * 100);
          beadsBox.appendChild(el);
        });
        $('v2Empty').hidden = slots.some(function (id) { return id !== FILL; });
        summary();
      }

      function pills() {
        document.querySelectorAll('#v2Types .v2-pill').forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-type') === type.id)); });
        var box = $('v2Sizes'); box.innerHTML = '';
        type.sizes.forEach(function (z) {
          var b = document.createElement('button'); b.type = 'button'; b.className = 'v2-pill'; b.setAttribute('data-size', z.id);
          b.setAttribute('aria-pressed', String(z.id === size.id)); b.textContent = z.name; box.appendChild(b);
        });
        $('v2SizeLabel').textContent = type.sizeLabel;
      }

      function summary() {
        var groups = {}, ids = [], beadsSum = 0;
        slots.forEach(function (id) { if (!groups[id]) { groups[id] = 0; ids.push(id); } groups[id]++; });
        var dl = $('v2Lines'); dl.innerHTML = '';
        var row = function (a, b) { var d = document.createElement('div'); var t = document.createElement('dt'); t.textContent = a; var v = document.createElement('dd'); v.textContent = b; d.appendChild(t); d.appendChild(v); dl.appendChild(d); };
        row(type.name + ', ' + size.name + ' · ' + slots.length + ' бусин 10 мм', rub(size.price));
        ids.sort(function (a, b) { return (a === FILL ? 0 : 1) - (b === FILL ? 0 : 1); }).forEach(function (id) {
          var s = bead(id), sum = s.price * groups[id]; beadsSum += sum;
          row(s.name + ' × ' + groups[id], sum ? '+' + rub(sum) : 'в цене');
        });
        var total = size.price + beadsSum;
        $('v2Total').textContent = rub(total); $('v2StageTotal').textContent = rub(total);
        var used = ids.filter(function (id) { return id !== FILL; });
        $('v2Title').textContent = type.name + (used.length ? ': ' + used.map(function (id) { return bead(id).name; }).join(', ') : ', белый');
        var hash = '#t=' + type.id + '&z=' + size.id + '&s=' + slots.join(',');
        if (location.hash !== hash) history.replaceState(null, '', hash);
        store('viva-kb2', snapshot());
        orderText = 'Здравствуйте! Хочу браслет из конструктора ViVA:\n' + type.name + ', ' + size.name + ', ' + slots.length + ' бусин 10 мм\n' +
          'Бусины по кругу, начиная от ' + (type.gap ? 'замка' : 'передней') + ': ' + slots.map(function (id) { return bead(id).name; }).join(', ') + '\n' +
          'Сумма по конструктору: ' + rub(total) + '\n' + location.href;
        $('v2Status').textContent = '';
        filterTrack();
      }

      function say(t) { $('v2Msg').textContent = t; }

      // ставим камень: в выделенные бусины, иначе на первое белое место
      function put(id) {
        remember();
        if (sel.length) { sel.forEach(function (i) { slots[i] = id; }); sel = []; }
        else {
          var i = slots.indexOf(FILL);
          if (i < 0) { undo.pop(); say('Свободных белых мест нет. Нажмите бусину на браслете, чтобы заменить её, или перетащите камень прямо на неё.'); return; }
          slots[i] = id;
        }
        say(''); render();
      }

      // ---------- перетаскивание ----------
      var drag = null;
      function centers() {
        var out = [];
        beadsBox.querySelectorAll('.v2-bead').forEach(function (el) {
          var r = el.getBoundingClientRect(); out.push({ i: Number(el.getAttribute('data-i')), x: r.left + r.width / 2, y: r.top + r.height / 2, r: r.width / 2, el: el });
        });
        return out;
      }
      // ближайшее место: в пределах сцены с запасом, как «притягивание»
      function nearest(x, y) {
        var r = stage.getBoundingClientRect(), padX = r.width * 0.08, padY = r.height * 0.18;
        if (x < r.left - padX || x > r.right + padX || y < r.top - padY || y > r.bottom + padY) return null;
        var best = null, bd = 1e9;
        centers().forEach(function (c) { var d = (c.x - x) * (c.x - x) + (c.y - y) * (c.y - y); if (d < bd) { bd = d; best = c; } });
        return best;
      }
      function mark(t) {
        beadsBox.querySelectorAll('.is-target').forEach(function (e) { e.classList.remove('is-target'); });
        if (t) t.el.classList.add('is-target');
      }
      function startDrag(e) {
        drag.on = true;
        var g = document.createElement('img'); g.className = 'v2-ghost'; g.src = sprite(drag.id); g.alt = '';
        var c = centers(), w = c.length ? Math.max.apply(null, c.map(function (q) { return q.r * 2; })) : 64;
        g.style.width = g.style.height = Math.max(44, w) + 'px';
        document.body.appendChild(g); drag.ghost = g;
        document.documentElement.classList.add('v2-dragging');
        if (drag.src === 'bead') drag.fromEl.classList.add('is-lifted');
        if (drag.src === 'palette') drag.item.classList.add('is-taken');
        moveDrag(e);
      }
      function moveDrag(e) {
        drag.ghost.style.transform = 'translate(' + (e.clientX - drag.ghost.offsetWidth / 2) + 'px,' + (e.clientY - drag.ghost.offsetHeight / 2) + 'px)';
        var t = nearest(e.clientX, e.clientY);
        if (t && drag.src === 'bead' && t.i === drag.from) t = null;
        drag.target = t; mark(t);
      }
      function endDrag() {
        if (!drag) return;
        if (drag.timer) clearTimeout(drag.timer);
        var d = drag; drag = null;
        document.documentElement.classList.remove('v2-dragging');
        if (d.ghost) d.ghost.remove();
        if (d.item) d.item.classList.remove('is-taken');
        mark(null);
        if (!d.on) {
          // короткое нажатие без перетаскивания
          if (d.src === 'palette') put(d.id);
          else { var k = sel.indexOf(d.from); if (k >= 0) sel.splice(k, 1); else sel.push(d.from); render(); say(sel.length ? 'Выделено бусин: ' + sel.length + '. Теперь нажмите камень в ленте.' : ''); }
          return;
        }
        if (d.src === 'palette') {
          if (!d.target) return render();
          remember(); slots[d.target.i] = d.id; sel = [];
        } else {
          remember();
          if (d.target) { var a = slots[d.from]; slots[d.from] = slots[d.target.i]; slots[d.target.i] = a; }
          else slots[d.from] = FILL;
          sel = [];
        }
        say(''); render();
      }

      function begin(e, info) {
        if (e.button > 0) return;
        drag = info; drag.on = false; drag.x0 = e.clientX; drag.y0 = e.clientY; drag.touch = e.pointerType !== 'mouse';
        // на телефоне долгое нажатие тоже начинает перетаскивание
        if (drag.touch && info.src === 'palette') drag.timer = setTimeout(function () { if (drag && !drag.on) { startDrag({ clientX: drag.x0, clientY: drag.y0 }); } }, 280);
      }
      window.addEventListener('pointermove', function (e) {
        if (!drag) return;
        if (!drag.on) {
          var dx = e.clientX - drag.x0, dy = e.clientY - drag.y0;
          if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
          // в ленте горизонтальный жест — прокрутка, вертикальный — перетаскивание
          if (drag.touch && drag.src === 'palette' && Math.abs(dx) > Math.abs(dy)) { clearTimeout(drag.timer); drag = null; return; }
          clearTimeout(drag.timer); startDrag(e);
        } else { e.preventDefault(); moveDrag(e); }
      }, { passive: false });
      window.addEventListener('pointerup', endDrag);
      window.addEventListener('pointercancel', function () { if (drag && !drag.on) { clearTimeout(drag.timer); drag = null; } else endDrag(); });

      track.addEventListener('pointerdown', function (e) {
        var b = e.target.closest('.v2-take'); if (!b) return;
        var item = b.closest('.v2-item');
        begin(e, { src: 'palette', id: item.getAttribute('data-id'), item: item });
      });
      track.addEventListener('click', function (e) {
        var f = e.target.closest('.v2-fav');
        if (f) { var id = f.closest('.v2-item').getAttribute('data-id'), k = favs.indexOf(id); if (k >= 0) favs.splice(k, 1); else favs.push(id); store('viva-kb2-favs', favs); filterTrack(); return; }
        // клавиатура: Enter на камне
        var b = e.target.closest('.v2-take'); if (b && e.detail === 0) put(b.closest('.v2-item').getAttribute('data-id'));
      });
      track.addEventListener('contextmenu', function (e) { if (e.target.closest('.v2-take')) e.preventDefault(); });
      beadsBox.addEventListener('pointerdown', function (e) {
        var el = e.target.closest('.v2-bead'); if (!el) return;
        e.preventDefault();
        begin(e, { src: 'bead', from: Number(el.getAttribute('data-i')), id: slots[Number(el.getAttribute('data-i'))], fromEl: el });
      });
      beadsBox.addEventListener('keydown', function (e) {
        var el = e.target.closest('.v2-bead'); if (!el || (e.key !== 'Enter' && e.key !== ' ')) return;
        e.preventDefault(); var i = Number(el.getAttribute('data-i')), k = sel.indexOf(i);
        if (k >= 0) sel.splice(k, 1); else sel.push(i); render();
        var again = beadsBox.querySelector('[data-i="' + i + '"]'); if (again) again.focus();
      });

      // ---------- лента ----------
      function filterTrack() {
        var q = $('v2Search').value.trim().toLowerCase();
        var used = slots.filter(function (id, i) { return id !== FILL && slots.indexOf(id) === i; });
        var shown = 0;
        track.querySelectorAll('.v2-item').forEach(function (it) {
          var id = it.getAttribute('data-id'), fav = favs.indexOf(id) >= 0;
          var ok = (tab === 'all' || (tab === 'used' && used.indexOf(id) >= 0) || (tab === 'fav' && fav)) && (!q || it.getAttribute('data-name').indexOf(q) >= 0);
          it.hidden = !ok; if (ok) shown++;
          var f = it.querySelector('.v2-fav'); f.setAttribute('aria-pressed', String(fav)); f.textContent = fav ? '♥' : '♡';
        });
        track.setAttribute('data-empty', shown ? '' : (tab === 'fav' ? 'Отметьте камни сердечком — они появятся здесь.' : tab === 'used' ? 'В браслете пока только белые бусины.' : 'Ничего не нашлось.'));
      }
      document.querySelectorAll('.v2-tab').forEach(function (b) {
        b.addEventListener('click', function () {
          tab = b.getAttribute('data-tab');
          document.querySelectorAll('.v2-tab').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
          filterTrack();
        });
      });
      $('v2Search').addEventListener('input', filterTrack);

      // ---------- тип, размер, помощники ----------
      $('v2Types').addEventListener('click', function (e) {
        var b = e.target.closest('[data-type]'); if (!b || b.getAttribute('data-type') === type.id) return;
        remember(); type = byId(D.TYPES, b.getAttribute('data-type'));
        size = byId(type.sizes, type.id === 'stretch' ? '17' : type.sizes[0].id);
        var before = slots.length; fit(size.count); pills(); render();
        say(before > slots.length ? 'Бусин стало меньше: последние ' + (before - slots.length) + ' убраны. Их можно вернуть кнопкой «Отменить».' : '');
      });
      $('v2Sizes').addEventListener('click', function (e) {
        var b = e.target.closest('[data-size]'); if (!b) return;
        remember(); size = byId(type.sizes, b.getAttribute('data-size'));
        var before = slots.length; fit(size.count); pills(); render();
        say(before > slots.length ? 'Бусин стало меньше: последние ' + (before - slots.length) + ' убраны. Их можно вернуть кнопкой «Отменить».' : '');
      });
      $('v2Auto').addEventListener('click', function () {
        var used = slots.filter(function (id, i) { return id !== FILL && slots.indexOf(id) === i; });
        if (!used.length) { say('Сначала перетащите на браслет хотя бы один камень — остальные места заполнятся вашими камнями по очереди.'); return; }
        if (slots.indexOf(FILL) < 0) { say('Белых мест не осталось — браслет уже собран.'); return; }
        remember(); var k = 0;
        slots = slots.map(function (id) { return id === FILL ? used[k++ % used.length] : id; });
        sel = []; say(''); render();
      });
      $('v2Clear').addEventListener('click', function () { remember(); slots = slots.map(function () { return FILL; }); sel = []; say(''); render(); });
      $('v2Undo').addEventListener('click', function () {
        var st = undo.pop(); if (!st) return; restore(st); sel = []; pills(); say(''); render();
        $('v2Undo').disabled = !undo.length;
      });
      document.querySelectorAll('[data-tpl]').forEach(function (b) {
        b.addEventListener('click', function () {
          var t = byId(D.TEMPLATES, b.getAttribute('data-tpl'));
          remember(); type = byId(D.TYPES, t.type); size = byId(type.sizes, t.size);
          slots = []; fit(size.count);
          t.fill.forEach(function (f) { for (var i = f.first; i < slots.length; i += f.step) slots[i] = f.bead; });
          sel = []; pills(); say(''); render();
        });
      });

      function copy(text, done) { if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(done, function () {}); }
      $('v2Order').addEventListener('click', function () { copy(orderText, function () { $('v2Status').textContent = 'Описание браслета скопировано — вставьте его в чат с мастером.'; }); });
      $('v2Copy').addEventListener('click', function () {
        if (navigator.clipboard && window.isSecureContext) copy(location.href, function () { $('v2Status').textContent = 'Ссылка на этот браслет скопирована.'; });
        else prompt('Скопируйте ссылку:', location.href);
      });

      // ---------- старт: ссылка, затем сохранённый в браузере браслет ----------
      var p = {};
      location.hash.replace(/^#/, '').split('&').forEach(function (kv) { var i = kv.indexOf('='); if (i > 0) p[kv.slice(0, i)] = decodeURIComponent(kv.slice(i + 1)); });
      var saved = p.t ? { t: p.t, z: p.z, s: (p.s || '').split(',') } : load('viva-kb2');
      if (saved && saved.t) restore(saved); else fit(size.count);
      pills(); render();
    })();
  </script>
</Layout>

<style is:global>
