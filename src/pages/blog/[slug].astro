---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}

const post = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const formatDate = (date) => new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
---
<Layout title={`${post.data.title} — журнал ViVA`} description={post.data.description}>
  <article class="article-page">
    <header class="article-header">
      <div class="container article-header-inner">
        <div class="breadcrumbs"><a href={base}>Главная</a> · <a href={`${base}blog/`}>Журнал</a> · {post.data.category}</div>
        <div class="post-meta"><span>{post.data.category}</span><span>{formatDate(post.data.pubDate)}</span><span>{post.data.readTime}</span></div>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
      </div>
    </header>
    <div class="container article-cover"><img src={post.data.cover} alt="" /></div>
    <div class="container article-layout">
      <div class="article-body"><Content /></div>
      <aside class="article-aside">
        <span class="eyebrow">ViVA рекомендует</span>
        <p>Сохраняйте статью и возвращайтесь к ней, когда собираете образ или выбираете подарок.</p>
        <a class="text-link" href={`${base}catalog/`}>Перейти в каталог →</a>
      </aside>
    </div>
    <section class="container discussion-card">
      <div><span class="eyebrow">Продолжим разговор</span><h2>Обсудить статью</h2><p>Поделитесь своим опытом в сообществе ViVA или задайте вопрос мастеру лично.</p></div>
      <div class="discussion-actions"><a class="button" href="https://t.me/viva_del_arte" target="_blank" rel="noopener">Telegram ViVA</a><a class="button outline" href="https://t.me/vafanasievav" target="_blank" rel="noopener">Написать мастеру</a></div>
    </section>
  </article>
</Layout>
