---
import Layout from '../layouts/Layout.astro';
import { BASES, STONES, BEADS, PENDANTS, PENDANT_MAX } from '../data/konstruktor.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const img = `${base}images/konstruktor/`;
const master = 'https://t.me/vafanasievav';
const rub = (n) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' ₽';
const b0 = BASES[2];
const s0 = STONES[1];
const data = JSON.stringify({ BASES, STONES, BEADS, PENDANTS, PENDANT_MAX });
const add0 = b0.sizeAdd[b0.sizes.indexOf(b0.sizeDefault)];
const total0 = b0.price + add0 + s0.price;
const stonesWord = (n) => (n === 1 ? 'камень' : n < 5 ? 'камня' : 'камней');
const addLabel = (n) => (n ? '+' + rub(n) : 'базовый');

// Посадка по умолчанию (кольцо + камень) рассчитана заранее, чтобы превью было собрано и без JavaScript.
const m = b0.mount;
const sw = 2 * m.r * s0.ringW, sh = sw * s0.ratio;
const stoneStyle = `left:${(m.cx - sw / 2) / 10}%;top:${(m.cy + m.r - sh) / 10}%;width:${sw / 10}%`;
const prongStyle = `left:${m.prongs.x / 10}%;top:${m.prongs.y / 10}%;width:${m.prongs.w / 10}%`;
---
<Layout title="Конструктор украшений — ViVA" description="Соберите украшение ViVA: основа, натуральный камень и размер с живым превью." noindex>
  <section class="page-hero kb-hero">
    <div class="container">
      <div class="breadcrumbs">Главная / Конструктор</div>
      <h1>Соберите своё украшение</h1>
      <p>Выберите основу, размер, количество камней и сами камни. Превью и цена меняются сразу, а готовый дизайн можно отправить мастеру.</p>
    </div>
  </section>

  <section class="kb">
    <div class="container kb-grid">
      <div class="kb-stage-col">
        <div class="kb-stage" id="kbStage">
          <img class="kb-layer kb-base" id="kbBase" src={`${img}base-${b0.id}.jpg`} alt="" width="1000" height="1000" />
          <div class="kb-layer kb-stones-layer" id="kbStones"><img class="kb-stone" src={`${img}stone-${s0.id}.png`} alt="" style={stoneStyle} /></div>
          <img class="kb-layer kb-prongs" id="kbProngs" src={`${img}ring-prongs.png`} alt="" style={prongStyle} />
          <svg class="kb-layer kb-bail" id="kbBail" style="display:none" viewBox="0 0 1000 1000" aria-hidden="true">
            <defs>
              <linearGradient id="kbSilver" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#f4f4f6" />
                <stop offset=".45" stop-color="#a9a9b0" />
                <stop offset=".7" stop-color="#e6e6ea" />
                <stop offset="1" stop-color="#8d8d95" />
              </linearGradient>
              <linearGradient id="kbGold" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#f6e3a6" />
                <stop offset=".45" stop-color="#c49a45" />
                <stop offset=".7" stop-color="#ecd28c" />
                <stop offset="1" stop-color="#a27a2c" />
              </linearGradient>
            </defs>
            <g id="kbBails"></g>
          </svg>
          <div class="kb-layer kb-hot" id="kbHot" role="group" aria-label="Позиции камней на превью"></div>
          <div class="kb-badge" aria-live="polite"><small>Итого</small><b id="kbStageTotal">{rub(total0)}</b></div>
        </div>
        <p class="kb-cap" id="kbCap">{b0.name} · {s0.name}</p>
        <p class="kb-note">Превью условное: камень посажен на фотографию основы. Перед изготовлением мастер согласует с вами детали.</p>
      </div>

      <div class="kb-panel">
        <noscript><p class="kb-nojs">Превью обновляется с включённым JavaScript. Варианты и цены видны и без него.</p></noscript>
        <form id="kbForm" onsubmit="return false">
          <fieldset class="kb-step">
            <legend><span class="kb-num">1</span> Основа</legend>
            <div class="kb-cards kb-bases">
              {BASES.map((b) => (
                <label class="kb-card">
                  <input type="radio" name="base" value={b.id} checked={b.id === b0.id} />
                  <img src={`${img}thumb-${b.id}.jpg`} alt="" width="240" height="240" loading="lazy" />
                  <span class="kb-name">{b.name}</span>
                  <span class="kb-meta">{b.material}</span>
                  <span class="kb-price">от {rub(b.price)}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="kb-step">
            <legend><span class="kb-num">2</span> <span id="kbSizeLabel">{b0.sizeLabel}</span></legend>
            <div class="kb-sizes" id="kbSizes">
              {b0.sizes.map((z, i) => (
                <label class="kb-pill"><input type="radio" name="size" value={z} checked={z === b0.sizeDefault} /><span>{z}<small>{addLabel(b0.sizeAdd[i])}</small></span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="kb-step" id="kbCountStep">
            <legend><span class="kb-num">3</span> Количество камней</legend>
            <div class="kb-sizes" id="kbCounts">
              {b0.counts.map((c) => (
                <label class="kb-pill"><input type="radio" name="count" value={c.n} checked={c.n === 1} /><span>{c.n} {stonesWord(c.n)}<small>{c.mult === 1 ? 'в цене' : '+' + rub(s0.price * (c.mult - 1))}</small></span></label>
              ))}
            </div>
            <p class="kb-hint" id="kbCountHint"></p>
          </fieldset>

          <fieldset class="kb-step">
            <legend><span class="kb-num" id="kbStoneNum">4</span> <span id="kbStoneLegend">Камень</span></legend>
            <div class="kb-slots" id="kbSlots" hidden>
              <p class="kb-hint" id="kbSlotHint">Выберите позицию на изделии, затем камень для неё.</p>
              <div class="kb-slot-row" id="kbSlotRow" role="group" aria-label="Позиции камней"></div>
              <div class="kb-links">
                <button class="kb-link" type="button" id="kbAll">Сделать все камни как выбранный</button>
                <button class="kb-link" type="button" id="kbReset" hidden>Вернуть как в шаблоне</button>
              </div>
            </div>
            <div class="kb-cards kb-stones" id="kbCutSet">
              {STONES.map((s) => (
                <label class="kb-card">
                  <input type="radio" name="stone" value={s.id} checked={s.id === s0.id} />
                  <span class="kb-chip"><img src={`${img}chip-${s.id}.png`} alt="" loading="lazy" /></span>
                  <span class="kb-name">{s.name}</span>
                  <span class="kb-meta">{s.cut} · {s.mood}</span>
                  <span class="kb-price">+{rub(s.price)}</span>
                </label>
              ))}
            </div>
            <div class="kb-cards kb-stones kb-beads" id="kbBeadSet" hidden>
              {BEADS.map((s) => (
                <label class="kb-card">
                  <input type="radio" name="stone" value={s.id} />
                  <span class="kb-chip"><img src={`${img}bead-${s.id}.png`} alt="" loading="lazy" /></span>
                  <span class="kb-name">{s.name}</span>
                  <span class="kb-meta">{s.cut} · {s.mood}</span>
                  <span class="kb-price">{s.price ? '+' + rub(s.price) : 'в цене'}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="kb-step" id="kbPendStep" hidden>
            <legend><span class="kb-num">4</span> Подвески</legend>
            <p class="kb-hint kb-pend-hint" id="kbPendHint">Можно добавить до {PENDANT_MAX} подвесок, они висят на верхних бусинах. Нажмите ещё раз, чтобы убрать.</p>
            <div class="kb-cards kb-stones kb-pends">
              {PENDANTS.map((d) => (
                <label class="kb-card">
                  <input type="checkbox" name="pendant" value={d.id} />
                  <span class="kb-chip"><img src={`${img}pend-${d.id}.png`} alt="" loading="lazy" /></span>
                  <span class="kb-name">{d.name}</span>
                  <span class="kb-meta">{d.note}</span>
                  <span class="kb-price">+{rub(d.price)}</span>
                </label>
              ))}
            </div>
          </fieldset>

        </form>

        <div class="kb-summary" id="kbSummary">
          <div class="eyebrow">Ваше украшение</div>
          <p class="kb-sum-title" id="kbTitle">{b0.name} с камнем «{s0.name}»</p>
          <dl class="kb-lines">
            <div><dt id="kbBaseName">{b0.name}</dt><dd id="kbBasePrice">{rub(b0.price)}</dd></div>
            <div><dt id="kbSizeName">{b0.sizeLabel}: {b0.sizeDefault}</dt><dd id="kbSize">{add0 ? '+' + rub(add0) : '0\u00A0₽'}</dd></div>
            <div class="kb-stone-row"><dt>{s0.name}, {s0.cut.toLowerCase()}</dt><dd>+{rub(s0.price)}</dd></div>
            <div class="kb-total"><dt>Итого</dt><dd id="kbTotal">{rub(total0)}</dd></div>
          </dl>
          <div class="kb-actions">
            <a class="button" id="kbOrder" href={master} target="_blank" rel="noopener">Обсудить с мастером</a>
            <button class="button outline" type="button" id="kbCopy">Скопировать ссылку</button>
          </div>
          <p class="kb-status" id="kbStatus" role="status" aria-live="polite"></p>
          <p class="kb-fine">Цены и названия ориентировочные, окончательную стоимость подтверждает мастер. По кнопке «Обсудить с мастером» откроется Telegram, а описание дизайна скопируется — останется вставить его в чат.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="kb-bar">
    <div class="kb-bar-in">
      <a class="kb-mini" id="kbMini" href="#kbStage" data-scroll="kbStage" aria-label="Показать превью"></a>
      <span class="kb-bar-total"><small>Итого</small> <b id="kbBarTotal">{rub(total0)}</b></span>
      <a class="button" href="#kbSummary" data-scroll="kbSummary">К заказу</a>
    </div>
  </div>

  <script type="application/json" id="kbData" set:html={data}></script>
  <script is:inline>
    (function () {
      var D = JSON.parse(document.getElementById('kbData').textContent);
      var $ = function (id) { return document.getElementById(id); };
      var form = $('kbForm'), stage = $('kbStage');
      var baseImg = $('kbBase'), stonesBox = $('kbStones'), prongs = $('kbProngs'), bail = $('kbBail'), bails = $('kbBails');
      var imgDir = baseImg.getAttribute('src').replace(/base-[a-z]+\.jpg$/, '');
      var rub = function (n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' ₽'; };
      var byId = function (list, id) { for (var i = 0; i < list.length; i++) if (list[i].id === id) return list[i]; return list[0]; };
      var pct = function (v) { return (v / 10) + '%'; };
      var word = function (n) { return n === 1 ? 'камень' : n < 5 ? 'камня' : 'камней'; };
      var orderText = '', shownBase = '';
      var ALL = D.STONES.concat(D.BEADS);
      var st = function (id) { return byId(ALL, id); };
      var isBeads = function (b) { return b.mount.type === 'beads'; };
      var setOf = function (b) { return isBeads(b) ? D.BEADS : D.STONES; };
      var isBead = function (id) { return D.BEADS.some(function (s) { return s.id === id; }); };
      var chip = function (id) { return imgDir + (isBead(id) ? 'bead-' : 'chip-') + id + '.png'; };
      // выбор камней запоминается отдельно для бусинного браслета и для остальных основ
      var memo = {}, curSet = '', beadsLoaded = false;
      // подвески браслета «Иней» в порядке выбора: первая висит по центру, затем слева и справа
      var pends = [];
      var pendOf = function (id) { return byId(D.PENDANTS, id); };

      // slots[i] — камень на позиции i (0 — центральная); active — позиция, которую сейчас меняют
      var slots = [form.querySelector('input[name=stone]:checked').value], active = 0;

      D.BASES.forEach(function (b) { new Image().src = imgDir + 'base-' + b.id + '.jpg'; });
      D.STONES.forEach(function (s) { new Image().src = imgDir + 'stone-' + s.id + '.png'; });

      function pills(boxId, name, items, sel) {
        var box = $(boxId); box.innerHTML = '';
        items.forEach(function (it) {
          var l = document.createElement('label'); l.className = 'kb-pill';
          var i = document.createElement('input'); i.type = 'radio'; i.name = name; i.value = it.value; i.checked = String(it.value) === String(sel);
          var s = document.createElement('span'); s.textContent = it.label;
          var m = document.createElement('small'); m.textContent = it.note; s.appendChild(m);
          l.appendChild(i); l.appendChild(s); box.appendChild(l);
        });
      }
      function renderSizes(b, keep) {
        var sel = b.sizes.indexOf(keep) >= 0 ? keep : b.sizeDefault;
        pills('kbSizes', 'size', b.sizes.map(function (z, k) { return { value: z, label: z, note: b.sizeAdd[k] ? '+' + rub(b.sizeAdd[k]) : 'базовый' }; }), sel);
        $('kbSizeLabel').textContent = b.sizeLabel;
      }
      function countOf(b, n) { for (var i = 0; i < b.counts.length; i++) if (b.counts[i].n === n) return b.counts[i]; return b.counts[0]; }
      function renderCounts(b, keep) {
        var s = st(slots[0]);
        $('kbCountStep').hidden = b.counts.length < 2;
        pills('kbCounts', 'count', b.counts.map(function (c) { return { value: c.n, label: c.n + ' ' + word(c.n), note: c.mult === 1 ? 'в цене' : b.mount.type === 'ring' ? '+' + rub(s.price * (c.mult - 1)) : 'цена камня × ' + c.n }; }), countOf(b, keep).n);
      }
      function perSlot(b, n) { return isBeads(b) || (b.mount.type === 'pendant' && n > 1); }
      // порядок позиций для подписи кнопок: подвески слева направо, бусины по часовой стрелке от верхней
      function order(n, b) { return b && isBeads(b) ? b.mount.points.map(function (p, i) { return i; }) : n === 5 ? [3, 1, 0, 2, 4] : n === 3 ? [1, 0, 2] : [0]; }

      function renderSlots(b, n) {
        var on = perSlot(b, n);
        $('kbSlots').hidden = !on;
        $('kbStoneLegend').textContent = isBeads(b) ? 'Бусины' : on ? 'Камни' : 'Камень';
        $('kbStoneNum').textContent = b.counts.length < 2 ? 3 : 4;
        $('kbCutSet').hidden = isBeads(b); $('kbBeadSet').hidden = !isBeads(b);
        if (!on) return;
        $('kbSlotHint').textContent = isBeads(b) ? 'Каждую из 20 бусин можно заменить. Нажмите на бусину на фото или на её номер ниже, затем выберите камень. Номера идут по часовой стрелке от верхней.' : 'Нажмите на камень на фото или на его номер ниже, затем выберите камень для этой позиции.';
        $('kbAll').textContent = isBeads(b) ? 'Сделать все бусины как выбранная' : 'Сделать все камни как выбранный';
        $('kbReset').hidden = !isBeads(b);
        var row = $('kbSlotRow'); row.innerHTML = '';
        row.classList.toggle('is-many', n > 5);
        order(n, b).forEach(function (i, k) {
          var s = st(slots[i]);
          var btn = document.createElement('button'); btn.type = 'button'; btn.className = 'kb-slot' + (i === active ? ' is-active' : '');
          btn.setAttribute('aria-pressed', String(i === active));
          btn.setAttribute('aria-label', 'Позиция ' + (k + 1) + ': ' + s.name);
          var im = document.createElement('img'); im.src = chip(s.id); im.alt = '';
          var sp = document.createElement('span'); sp.textContent = k + 1;
          btn.appendChild(im); btn.appendChild(sp);
          btn.addEventListener('click', function () { selectSlot(i); });
          row.appendChild(btn);
        });
      }
      // выбор позиции: кнопкой под превью или нажатием на камень на фотографии
      var cur = null;
      function selectSlot(i) { active = i; syncStoneRadios(); renderSlots(cur.b, cur.n); markHot(); }
      function markHot() {
        $('kbHot').querySelectorAll('.kb-spot').forEach(function (h) {
          var on = Number(h.getAttribute('data-i')) === active;
          h.classList.toggle('is-active', on); h.setAttribute('aria-pressed', String(on));
        });
      }
      function renderHot(b, n, spots) {
        var box = $('kbHot'); box.innerHTML = '';
        box.classList.toggle('kb-hot-quiet', isBeads(b));
        if (!perSlot(b, n)) return;
        order(n, b).forEach(function (i, k) {
          var sp = spots[i]; if (!sp) return;
          var h = document.createElement('button'); h.type = 'button'; h.className = 'kb-spot'; h.setAttribute('data-i', i);
          h.setAttribute('aria-label', 'Выбрать позицию ' + (k + 1) + ': ' + st(slots[i]).name);
          h.style.left = pct(sp[0]); h.style.top = pct(sp[1]); h.style.width = pct(2 * sp[2]); h.style.height = pct(2 * sp[2]);
          h.addEventListener('click', function () { selectSlot(i); });
          box.appendChild(h);
        });
        markHot();
      }
      function syncStoneRadios() {
        var r = form.querySelector('input[name=stone][value="' + slots[active] + '"]'); if (r) r.checked = true;
      }

      // камни: [x, y, ширина, id] в пикселях холста 1000×1000; центральный рисуется последним, поверх боковых
      function place(b, n) {
        var m = b.mount, items = [], rings = '', spots = [];
        cur = { b: b, n: n };
        if (m.type === 'pendant') {
          var sc = n === 1 ? 1 : n === 3 ? 0.62 : 0.52;
          var bs = 46 * m.k * (n === 1 ? 1 : 0.85);
          for (var i = n - 1; i >= 0; i--) {
            var s = st(slots[i]);
            var x = m.points[i][0], y = m.points[i][1], w = s.pendantW * m.k * sc;
            items.push([x - w / 2, y + bs * 0.75, w, s.id]);
            spots[i] = [x, y + bs * 0.75 + w * s.ratio / 2, Math.max(w, w * s.ratio) / 2];
            rings += '<ellipse cx="' + x + '" cy="' + (y - bs * 0.1 + bs / 2) + '" rx="' + bs * 0.275 + '" ry="' + bs / 2 + '" fill="none" stroke="url(#kbSilver)" stroke-width="' + Math.max(5, bs * 0.17) + '"/>';
          }
          bail.style.display = ''; prongs.hidden = true;
        } else if (m.type === 'beads') {
          // бусины шаблона уже есть на фотографии — рисуем только заменённые
          m.points.forEach(function (p, i) {
            spots[i] = [p[0], p[1], p[2] * m.f];
            if (slots[i] === m.def[i]) return;
            var d = 2 * p[2] * m.f;
            items.push([p[0] - d / 2, p[1] - d / 2, d, slots[i], 'bead']);
          });
          // подвески: колечко на бусине и подвеска под ним
          pends.forEach(function (id, k) {
            var d = pendOf(id), h = m.hooks[k], w = Math.min(d.w, 250 / d.ratio);
            rings += '<ellipse cx="' + h[0] + '" cy="' + (h[1] + 12) + '" rx="9" ry="15" fill="none" stroke="url(#' + (d.metal === 'gold' ? 'kbGold' : 'kbSilver') + ')" stroke-width="5"/>';
            items.push([h[0] - w * d.ax, h[1] + 20, w, d.id, 'pend']);
          });
          bail.style.display = ''; prongs.hidden = true;
        } else {
          var s0 = st(slots[0]);
          if (n === 3) [-1, 1].forEach(function (sg) {
            var w = 2 * m.r * m.side.f, h = w * s0.ratio;
            items.push([m.cx + sg * m.side.dx * m.r - w / 2, m.cy + m.side.dy * m.r - h / 2, w, s0.id]);
          });
          var w = 2 * m.r * s0.ringW, h = w * s0.ratio;
          items.push([m.cx - w / 2, s0.centered ? m.cy - h / 2 : m.cy + m.r - h, w, s0.id]);
          prongs.style.left = pct(m.prongs.x); prongs.style.top = pct(m.prongs.y); prongs.style.width = pct(m.prongs.w);
          bail.style.display = 'none'; prongs.hidden = false;
        }
        bails.innerHTML = rings;
        stonesBox.innerHTML = '';
        items.forEach(function (it) {
          var im = document.createElement('img'); im.className = it[4] ? 'kb-stone kb-' + it[4] : 'kb-stone'; im.alt = '';
          im.src = imgDir + (it[4] || 'stone') + '-' + it[3] + '.png';
          im.style.left = pct(it[0]); im.style.top = pct(it[1]); im.style.width = pct(it[2]);
          stonesBox.appendChild(im);
        });
        renderHot(b, n, spots);
      }

      function syncMini() {
        var c = stage.cloneNode(true);
        c.removeAttribute('id');
        c.querySelectorAll('[id]').forEach(function (n) { n.removeAttribute('id'); });
        c.querySelectorAll('defs, .kb-badge, .kb-hot').forEach(function (n) { n.remove(); });
        $('kbMini').innerHTML = ''; $('kbMini').appendChild(c);
      }

      function fitSlots(n, b) {
        while (slots.length < n) slots.push(isBeads(b) ? b.mount.def[slots.length] : slots[0]);
        slots.length = n;
        if (active >= n) active = 0;
      }

      // строки камней в итоге: одинаковые камни сгруппированы
      function stoneLines(b, c) {
        var lines = [], total = 0;
        if (b.mount.type === 'ring') {
          var s = st(slots[0]); total = s.price * c.mult;
          lines.push([s.name + ', ' + s.cut.toLowerCase() + (c.n > 1 ? ' × ' + c.n + ' (' + c.note + ')' : ''), total]);
        } else {
          var groups = {}, ids = [];
          slots.forEach(function (id) { if (!groups[id]) { groups[id] = 0; ids.push(id); } groups[id]++; });
          // бусины шаблона (в цене) — первыми строками
          if (isBeads(b)) ids.sort(function (x, y) { return (st(x).price ? 1 : 0) - (st(y).price ? 1 : 0); });
          ids.forEach(function (id) {
            var s = st(id), sum = s.price * groups[id]; total += sum;
            var label = isBeads(b) ? s.name + (s.price ? '' : ', как в шаблоне') : s.name + ', ' + s.cut.toLowerCase();
            lines.push([label + (groups[id] > 1 || c.n > 1 ? ' × ' + groups[id] : ''), sum]);
          });
        }
        if (isBeads(b)) pends.forEach(function (id) { var d = pendOf(id); total += d.price; lines.push(['Подвеска «' + d.name + '»', d.price]); });
        return { lines: lines, total: total };
      }

      function update(changed) {
        var f = new FormData(form);
        var b = byId(D.BASES, f.get('base'));
        if (changed === 'base') renderSizes(b, f.get('size'));
        var set = isBeads(b) ? 'bead' : 'cut';
        if (curSet && set !== curSet) {
          memo[curSet] = { slots: slots.slice(), active: active };
          var saved = memo[set] || { slots: set === 'bead' ? b.mount.def.slice() : [D.STONES[1].id], active: 0 };
          slots = saved.slots.slice(); active = saved.active;
        }
        curSet = set;
        if (set === 'bead' && !beadsLoaded) { beadsLoaded = true; D.BEADS.forEach(function (s) { new Image().src = chip(s.id); }); }
        var c = countOf(b, Number(new FormData(form).get('count')) || 1);
        if (changed === 'base' || changed === 'init') renderCounts(b, c.n);
        c = countOf(b, Number(new FormData(form).get('count')) || 1);
        if (!perSlot(b, c.n)) { slots = slots.map(function () { return slots[active] || slots[0]; }); active = 0; }
        fitSlots(c.n, b);
        renderSlots(b, c.n);
        syncStoneRadios();
        if (changed === 'stone' || changed === 'all') renderCounts(b, c.n);
        var z = new FormData(form).get('size');

        var apply = function () { baseImg.src = imgDir + 'base-' + b.id + '.jpg'; place(b, c.n); stage.classList.remove('kb-fading'); syncMini(); };
        if (shownBase && shownBase !== b.id) { stage.classList.add('kb-fading'); setTimeout(apply, 160); } else apply();
        shownBase = b.id;

        var sizeAdd = b.sizeAdd[Math.max(0, b.sizes.indexOf(z))];
        var sl = stoneLines(b, c);
        var total = b.price + sizeAdd + sl.total;
        var main = st(slots[0]);
        var many = sl.lines.length > 1;
        $('kbPendStep').hidden = !isBeads(b);
        if (isBeads(b)) {
          var swapped = slots.filter(function (id, i) { return id !== b.mount.def[i]; }).length;
          var tail = (swapped ? 'заменено бусин: ' + swapped : 'как в шаблоне') + (pends.length ? ', подвесок: ' + pends.length : '');
          $('kbCap').textContent = b.name + ' · ' + tail;
          $('kbTitle').textContent = b.name + ', ' + tail;
        } else {
          $('kbCap').textContent = b.name + ' · ' + (many ? 'камни на выбор' : main.name);
          $('kbTitle').textContent = b.name + (many ? ' с камнями на выбор' : ' с камнем «' + main.name + '»');
        }
        $('kbBaseName').textContent = b.name; $('kbBasePrice').textContent = rub(b.price);
        $('kbSizeName').textContent = b.sizeLabel + ': ' + z; $('kbSize').textContent = sizeAdd ? '+' + rub(sizeAdd) : rub(0);
        var dl = document.querySelector('.kb-lines'), totalRow = dl.querySelector('.kb-total');
        dl.querySelectorAll('.kb-stone-row').forEach(function (r) { r.remove(); });
        sl.lines.forEach(function (ln) {
          var d = document.createElement('div'); d.className = 'kb-stone-row';
          var dt = document.createElement('dt'); dt.textContent = ln[0];
          var dd = document.createElement('dd'); dd.textContent = ln[1] ? '+' + rub(ln[1]) : 'в цене';
          d.appendChild(dt); d.appendChild(dd); dl.insertBefore(d, totalRow);
        });
        $('kbCountHint').textContent = c.note ? '3 камня — ' + c.note + ': боковые стоят половину цены камня.' : '';
        $('kbTotal').textContent = rub(total); $('kbBarTotal').textContent = rub(total); $('kbStageTotal').textContent = rub(total);

        var hash = '#b=' + b.id + '&z=' + encodeURIComponent(z) + '&n=' + c.n + '&s=' + slots.join(',') + (isBeads(b) && pends.length ? '&p=' + pends.join(',') : '');
        if (location.hash !== hash) history.replaceState(null, '', hash);
        var positions = '';
        if (isBeads(b)) {
          var sw = [];
          slots.forEach(function (id, i) { if (id !== b.mount.def[i]) sw.push((i + 1) + ' — ' + st(id).name); });
          positions = '\n' + (sw.length ? 'Замены (номера бусин по часовой стрелке от верхней): ' + sw.join(', ') : 'Бусины как в шаблоне') +
            (pends.length ? '\nПодвески: ' + pends.map(function (id) { return pendOf(id).name; }).join(', ') : '');
        } else if (perSlot(b, c.n)) {
          positions = '\nКамни слева направо: ' + order(c.n, b).map(function (i) { return st(slots[i]).name; }).join(', ');
        }
        orderText = 'Здравствуйте! Хочу украшение из конструктора ViVA:\n' + b.name + '\n' +
          b.sizeLabel + ': ' + z + '\n' +
          sl.lines.map(function (l) { return l[0]; }).join('; ') + positions + '\n' +
          'Сумма по конструктору: ' + rub(total) + '\n' + location.href;
        $('kbStatus').textContent = '';
      }

      function fromHash() {
        var p = {};
        location.hash.replace(/^#/, '').split('&').forEach(function (kv) {
          var i = kv.indexOf('='); if (i > 0) p[kv.slice(0, i)] = decodeURIComponent(kv.slice(i + 1));
        });
        if (!p.b) return;
        var b = byId(D.BASES, p.b);
        form.querySelector('input[name=base][value="' + b.id + '"]').checked = true;
        slots = (p.s || '').split(',').map(function (id) { return byId(setOf(b), id).id; });
        curSet = isBeads(b) ? 'bead' : 'cut';
        pends = (p.p || '').split(',').filter(function (id) { return D.PENDANTS.some(function (d) { return d.id === id; }); }).slice(0, D.PENDANT_MAX);
        syncPends();
        renderSizes(b, p.z);
        renderCounts(b, Number(p.n) || 1);
      }

      function copy(text, done) {
        if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(done, function () {});
      }

      // прокрутка без смены адреса: в адресе хранится выбранный дизайн
      document.querySelectorAll('[data-scroll]').forEach(function (a) {
        a.addEventListener('click', function (e) { e.preventDefault(); $(a.getAttribute('data-scroll')).scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      });
      function syncPends() {
        form.querySelectorAll('input[name=pendant]').forEach(function (i) {
          i.checked = pends.indexOf(i.value) >= 0;
          i.disabled = !i.checked && pends.length >= D.PENDANT_MAX;
        });
      }
      form.addEventListener('change', function (e) {
        if (e.target.name === 'stone') slots[active] = e.target.value;
        if (e.target.name === 'pendant') {
          var id = e.target.value, at = pends.indexOf(id);
          if (e.target.checked && at < 0 && pends.length < D.PENDANT_MAX) pends.push(id);
          if (!e.target.checked && at >= 0) pends.splice(at, 1);
          syncPends();
        }
        update(e.target.name);
      });
      $('kbAll').addEventListener('click', function () { slots = slots.map(function () { return slots[active]; }); update('all'); });
      $('kbReset').addEventListener('click', function () { slots = cur.b.mount.def.slice(); update('all'); });
      $('kbOrder').addEventListener('click', function () {
        copy(orderText, function () { $('kbStatus').textContent = 'Описание дизайна скопировано — вставьте его в чат с мастером.'; });
      });
      $('kbCopy').addEventListener('click', function () {
        if (navigator.clipboard && window.isSecureContext) copy(location.href, function () { $('kbStatus').textContent = 'Ссылка на этот дизайн скопирована.'; });
        else prompt('Скопируйте ссылку:', location.href);
      });

      fromHash();
      update(location.hash ? 'hash' : 'init');
    })();
  </script>
</Layout>

<style is:global>
