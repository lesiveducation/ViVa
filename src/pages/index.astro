---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { featuredProducts } from '../data/products.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const products = featuredProducts.map((product) => ({ ...product, image: `${base}${product.image}` }));
---
<Layout>
  <section class="hero"><div class="container hero-content"><div class="hero-title"><div class="eyebrow">Мастерская авторских украшений</div><h1>Украшения<br/>с характером</h1><p>Натуральные материалы, ручная работа и сочетания, которые невозможно повторить случайно.</p></div><div class="hero-mosaic"><figure><img src={`${base}images/viva/product-4.jpg`} alt="Колье ViVA в подарочной коробке" loading="eager" fetchpriority="high" /></figure><figure><img src={`${base}images/viva/product-1.jpg`} alt="Авторское украшение ViVA из цветных бусин" /></figure><figure><img src={`${base}images/viva/product-6.jpg`} alt="Колье ViVA с натуральными камнями" loading="lazy" /></figure></div><div class="hero-categories"><a href={`${base}catalog/?type=earrings`}>Серьги</a><a href={`${base}catalog/?type=necklaces`}>Колье</a><a href={`${base}catalog/?type=bracelets`}>Браслеты</a></div><div class="hero-actions"><a class="button outline" href={`${base}catalog/`}>Смотреть коллекцию</a><a class="button" href="https://t.me/vafanasievav" target="_blank" rel="noopener">Подобрать украшение</a></div></div></section>
  <section class="section white"><div class="container"><div class="section-head"><div><div class="eyebrow">Коллекция ViVA</div><h2>Новые украшения</h2></div><p>Каждое изделие собирается небольшим тиражом или в единственном экземпляре. Уточнить наличие можно у мастера.</p></div><div class="product-grid">{products.map((product)=><ProductCard {...product}/>)}</div></div></section>
  <section class="split"><div class="split-image"><img src={`${base}images/viva/about.jpg`} alt="Украшения ручной работы ViVA" loading="lazy" /></div><div class="split-copy"><div class="eyebrow">Образ начинается с детали</div><h2>Не просто дополнение к одежде</h2><p>ViVA создаёт украшения под настроение, событие и личную историю. Можно выбрать готовое изделие или придумать своё вместе с мастером.</p><p><a class="button outline" href={`${base}custom/`}>Создать своё украшение</a></p></div></section>
  <section class="section"><div class="container"><div class="features"><article class="feature"><span>01 / РУЧНАЯ РАБОТА</span><h3>Внимание к деталям</h3><p>Мастер вручную подбирает материалы, сочетания и фурнитуру.</p></article><article class="feature"><span>02 / ИНДИВИДУАЛЬНО</span><h3>Под ваш образ</h3><p>Цвет, длина и настроение украшения обсуждаются лично.</p></article><article class="feature"><span>03 / С ЗАБОТОЙ</span><h3>Гарантия мастера</h3><p>Поможем с регулировкой и ответим на вопросы по уходу.</p></article></div></div></section>
  <section class="character-section"><div class="container character-grid"><div class="character-image"><img src={`${base}images/viva/viva-girl.jpg`} alt="Девочка ViVA — фирменный персонаж бренда" loading="lazy" /></div><div class="character-copy"><div class="eyebrow">Знакомьтесь: девочка ViVA</div><h2>Та самая внутренняя смелость</h2><p>Она любит украшения, не боится яркости и всегда добавляет в образ личную деталь. Девочка ViVA будет появляться в историях, подсказках и специальных коллекциях бренда.</p><blockquote>«Украшения не изменят этот мир. А женщины, которые их носят, — да!»</blockquote><a class="button outline" href={`${base}about/`}>Узнать историю ViVA</a></div></div></section>
  <section class="cta-band"><div class="container cta-inner"><h2>Подберём украшение, которое будет ощущаться вашим</h2><a class="button" href="https://t.me/vafanasievav" target="_blank" rel="noopener">Написать мастеру</a></div></section>
</Layout>
